{
  "name": "valoshell",
  "description": "A custom, open-source menu for VALORANT, built with Tauri, Rust and SolidJS.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "tsc -p ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "ui:check": "tsc -p ui/tsconfig.json --noEmit",
    "ui:test": "vitest run --config ui/vite.config.ts",
    "ui:layout": "node ui/scripts/layout-sweep.mjs",
    "ui:looks": "node ui/scripts/look-sweep.mjs",
    "dev": "tauri dev",
    "build": "tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^2.0.1",
    "@tanstack/solid-virtual": "^3.13.53",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "lucide-solid": "^1.77.0",
    "solid-js": "^2.0.3"
  }
}
